{
  "name": "lanka-schools",
  "version": "1.0.0",
  "description": "Comprehensive dataset and library of Sri Lankan schools by educational zone and district. Essential for school admissions, EdTech apps, and GIS planning.",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./provinces": {
      "types": "./dist/provinces.d.ts",
      "import": "./dist/provinces.mjs",
      "require": "./dist/provinces.js"
    },
    "./districts": {
      "types": "./dist/districts.d.ts",
      "import": "./dist/districts.mjs",
      "require": "./dist/districts.js"
    },
    "./zones": {
      "types": "./dist/zones.d.ts",
      "import": "./dist/zones.mjs",
      "require": "./dist/zones.js"
    },
    "./national-schools": {
      "types": "./dist/national-schools.d.ts",
      "import": "./dist/national-schools.mjs",
      "require": "./dist/national-schools.js"
    },
    "./schools": {
      "types": "./dist/schools.d.ts",
      "import": "./dist/schools.mjs",
      "require": "./dist/schools.js"
    },
    "./data/provinces.json": "./data/provinces.json",
    "./data/districts.json": "./data/districts.json",
    "./data/zones.json": "./data/zones.json",
    "./data/national-schools.json": "./data/national-schools.json",
    "./data/schools.json": "./data/schools.json"
  },
  "files": [
    "dist",
    "data"
  ],
  "scripts": {
    "build": "tsup && tsc --declaration --emitDeclarationOnly",
    "test": "vitest run",
    "test:watch": "vitest",
    "data:build": "python3 scripts/build-data.py",
    "prepublishOnly": "npm run build && npm run test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mmsalmanfaris/lanka-schools.git"
  },
  "bugs": {
    "url": "https://github.com/mmsalmanfaris/lanka-schools/issues"
  },
  "homepage": "https://github.com/mmsalmanfaris/lanka-schools#readme",
  "keywords": [
    "sri-lanka",
    "schools",
    "sri-lankan-schools",
    "education-zones",
    "districts",
    "provinces",
    "national-schools",
    "edtech",
    "gis",
    "geospatial",
    "school-admissions",
    "colombo",
    "kandy",
    "galle",
    "jaffna",
    "open-data-sri-lanka"
  ],
  "author": "M.M. Salman Faris <mmsalmanfaaris01@gmail.com>",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.13.1",
    "tsup": "^8.3.6",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
